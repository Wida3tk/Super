rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'Maryam@sulukera.com';
    }

    function isSupervisor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/supervisors/$(request.auth.uid));
    }

    function isSupervisorOwner(supervisorId) {
      return exists(/databases/$(database)/documents/supervisors/$(supervisorId))
        && get(/databases/$(database)/documents/supervisors/$(supervisorId)).data.email == request.auth.token.email;
    }

    function isCurrentMonth(month) {
      let now = request.time;
      let currentMonth = string(now.year()) + "-" +
        (now.month() < 10 ? "0" + string(now.month()) : string(now.month()));
      return month == currentMonth;
    }

    match /supervisors/{supervisorId} {
      allow read: if resource.data.isActive == true
        || (request.auth != null && request.auth.token.email == resource.data.email)
        || isAdmin();
      allow write: if isAdmin();
    }

    match /availability/{slotId} {
      allow read: if true;
      allow create: if request.auth != null && isSupervisorOwner(request.resource.data.supervisorId);
      allow update: if false;
      allow delete: if request.auth != null && isSupervisorOwner(resource.data.supervisorId);
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trainees/{traineeId} {
      allow read: if isAdmin() ||
        (isSupervisor() &&
          resource.data.currentSupervisorId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin() ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid);
      allow create: if isAdmin() ||
        (isSupervisor() &&
          request.resource.data.supervisorId == request.auth.uid &&
          isCurrentMonth(request.resource.data.month));
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isSupervisor() &&
          resource.data.supervisorId == request.auth.uid &&
          isCurrentMonth(resource.data.month));
    }

    match /monthlySnapshots/{snapshotId} {
      allow read: if isAdmin() ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid);
      allow create: if isAdmin() ||
        (isSupervisor() && request.resource.data.supervisorId == request.auth.uid);
      allow update: if isAdmin() ||
        (isSupervisor() &&
          resource.data.supervisorId == request.auth.uid &&
          resource.data.lockedAt == null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["workHours", "requiredHours", "updatedAt"]));
      allow delete: if false;
    }

  }
}
