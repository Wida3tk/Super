rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    function isSupervisor() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/supervisors/$(request.auth.uid)) ||
          (request.auth.token.supervisorId != null &&
            exists(/databases/$(database)/documents/supervisors/$(request.auth.token.supervisorId))));
    }

    function supervisorId() {
      return request.auth.token.supervisorId != null
        ? request.auth.token.supervisorId
        : request.auth.uid;
    }

    function isSupervisorOwner(supervisorId) {
      return exists(/databases/$(database)/documents/supervisors/$(supervisorId))
        && get(/databases/$(database)/documents/supervisors/$(supervisorId)).data.email == request.auth.token.email;
    }

    function isCurrentMonth(month) {
      let now = request.time;
      let currentMonth = string(now.year()) + "-" +
        (now.month() < 10 ? "0" + string(now.month()) : string(now.month()));
      return month == currentMonth;
    }

    function isAssignedTrainee(traineeId) {
      return request.auth != null
        && request.auth.token.traineeId == traineeId
        && exists(/databases/$(database)/documents/trainees/$(traineeId))
        && get(/databases/$(database)/documents/trainees/$(traineeId)).data.status == "active"
        && get(/databases/$(database)/documents/trainees/$(traineeId)).data.currentSupervisorId != null;
    }

    match /supervisors/{supervisorId} {
      allow read: if resource.data.isActive == true
        || (request.auth != null && request.auth.token.email == resource.data.email)
        || isAdmin();
      allow write: if isAdmin();
    }

    match /availability/{slotId} {
      // Public clients only need open slots. Booked documents can contain
      // internal booking references and are served to owners via server APIs.
      allow read: if resource.data.isBooked == false;
      allow create: if request.auth != null && isSupervisorOwner(request.resource.data.supervisorId);
      allow update: if false;
      allow delete: if request.auth != null && isSupervisorOwner(resource.data.supervisorId);
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == resource.data.studentEmail)
        || (request.auth != null && isSupervisorOwner(resource.data.supervisorId));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Reviews must be created by a server endpoint after verifying the
      // completed booking; direct client creation is intentionally disabled.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trainees/{traineeId} {
      allow read: if isAdmin() ||
        isAssignedTrainee(traineeId) ||
        (isSupervisor() &&
          resource.data.currentSupervisorId == supervisorId());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin() ||
        (isSupervisor() && resource.data.supervisorId == supervisorId());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() ||
        (isSupervisor() && resource.data.supervisorId == supervisorId()) ||
        (request.auth != null &&
          request.auth.token.traineeId != null &&
          request.auth.token.traineeId in resource.data.traineeIds);
      allow create: if isAdmin() ||
        (isSupervisor() &&
          request.resource.data.supervisorId == supervisorId() &&
          isCurrentMonth(request.resource.data.month));
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isSupervisor() &&
          resource.data.supervisorId == supervisorId() &&
          isCurrentMonth(resource.data.month));
    }

    match /monthlySnapshots/{snapshotId} {
      allow read: if isAdmin() ||
        (isSupervisor() && resource.data.supervisorId == supervisorId()) ||
        isAssignedTrainee(resource.data.traineeId);
      allow create: if isAdmin() ||
        (isSupervisor() && request.resource.data.supervisorId == supervisorId());
      allow update: if isAdmin() ||
        (isSupervisor() &&
          resource.data.supervisorId == supervisorId() &&
          resource.data.lockedAt == null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["workHours", "requiredHours", "updatedAt"]));
      allow delete: if false;
    }

    match /fieldworkActivities/{activityId} {
      allow read: if isAdmin() ||
        isAssignedTrainee(resource.data.traineeId) ||
        (isSupervisor() && resource.data.supervisorId == supervisorId());
      allow write: if false;
    }

  }
}
