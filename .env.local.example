# ============================================
# SUPERVISION BOOKING PLATFORM — ENV TEMPLATE
# ============================================
# انسخ هذا الملف إلى .env.local وأكمل القيم

# -------- Firebase Client SDK --------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -------- Firebase Admin SDK --------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# بديل مناسب للمنصات التي لا تتعامل جيداً مع الأسطر المتعددة
FIREBASE_PRIVATE_KEY_BASE64=

# -------- Google Calendar API --------
# Service Account JSON كاملاً
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# البريد المركزي لـ Google Workspace (المنظم)
GOOGLE_CALENDAR_ORGANIZER_EMAIL=

# -------- Email Service --------
# يمكن استخدام Resend أو SendGrid
EMAIL_SERVICE_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Supervision Platform

# -------- App Config --------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# -------- Admin --------
# بريد المدير الرئيسي
ADMIN_EMAIL=admin@yourdomain.com
